<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.seating.mapper.SeatAiConfigMapper">

    <resultMap type="SeatAiConfig" id="SeatAiConfigResult">
        <result property="configId"        column="config_id"        />
        <result property="configName"      column="config_name"      />
        <result property="provider"        column="provider"         />
        <result property="apiUrl"          column="api_url"          />
        <result property="apiKey"          column="api_key"          />
        <result property="modelName"       column="model_name"       />
        <result property="reasoningEffort" column="reasoning_effort" />
        <result property="temperature"     column="temperature"      />
        <result property="maxTokens"       column="max_tokens"       />
        <result property="timeoutSeconds"  column="timeout_seconds"  />
        <result property="isDefault"       column="is_default"       />
        <result property="status"          column="status"           />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"          />
    </resultMap>

    <sql id="selectSeatAiConfigVo">
        select config_id, config_name, provider, api_url, api_key, model_name, reasoning_effort,
               temperature, max_tokens, timeout_seconds, is_default, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from seat_ai_config
    </sql>

    <select id="selectSeatAiConfigList" parameterType="SeatAiConfig" resultMap="SeatAiConfigResult">
        <include refid="selectSeatAiConfigVo"/>
        <where>
            del_flag = '0'
            <if test="configName != null and configName != ''"> and config_name like concat('%', #{configName}, '%')</if>
            <if test="provider != null and provider != ''"> and provider = #{provider}</if>
            <if test="modelName != null and modelName != ''"> and model_name like concat('%', #{modelName}, '%')</if>
            <if test="isDefault != null and isDefault != ''"> and is_default = #{isDefault}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by is_default desc, config_id desc
    </select>

    <select id="selectSeatAiConfigByConfigId" parameterType="Long" resultMap="SeatAiConfigResult">
        <include refid="selectSeatAiConfigVo"/>
        where config_id = #{configId} and del_flag = '0'
    </select>

    <insert id="insertSeatAiConfig" parameterType="SeatAiConfig" useGeneratedKeys="true" keyProperty="configId">
        insert into seat_ai_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="configName != null and configName != ''">config_name,</if>
            <if test="provider != null and provider != ''">provider,</if>
            <if test="apiUrl != null and apiUrl != ''">api_url,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">reasoning_effort,</if>
            <if test="temperature != null">temperature,</if>
            <if test="maxTokens != null">max_tokens,</if>
            <if test="timeoutSeconds != null">timeout_seconds,</if>
            <if test="isDefault != null">is_default,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="configName != null and configName != ''">#{configName},</if>
            <if test="provider != null and provider != ''">#{provider},</if>
            <if test="apiUrl != null and apiUrl != ''">#{apiUrl},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">#{reasoningEffort},</if>
            <if test="temperature != null">#{temperature},</if>
            <if test="maxTokens != null">#{maxTokens},</if>
            <if test="timeoutSeconds != null">#{timeoutSeconds},</if>
            <if test="isDefault != null">#{isDefault},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSeatAiConfig" parameterType="SeatAiConfig">
        update seat_ai_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="configName != null and configName != ''">config_name = #{configName},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="apiUrl != null and apiUrl != ''">api_url = #{apiUrl},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="reasoningEffort != null and reasoningEffort != ''">reasoning_effort = #{reasoningEffort},</if>
            <if test="temperature != null">temperature = #{temperature},</if>
            <if test="maxTokens != null">max_tokens = #{maxTokens},</if>
            <if test="timeoutSeconds != null">timeout_seconds = #{timeoutSeconds},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where config_id = #{configId}
    </update>

    <update id="clearDefaultExcept" parameterType="Long">
        update seat_ai_config
        set is_default = '0'
        where del_flag = '0'
        <if test="_parameter != null">
            and config_id != #{_parameter}
        </if>
    </update>

    <delete id="deleteSeatAiConfigByConfigId" parameterType="Long">
        update seat_ai_config set del_flag = '2' where config_id = #{configId}
    </delete>

    <delete id="deleteSeatAiConfigByConfigIds" parameterType="String">
        update seat_ai_config set del_flag = '2' where config_id in
        <foreach item="configId" collection="array" open="(" separator="," close=")">
            #{configId}
        </foreach>
    </delete>
</mapper>
